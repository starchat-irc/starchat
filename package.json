{
    "name": "starchat",
    "version": "0.0.0",
    "description": "IRCv3 web and desktop client",
    "license": "AGPL-3.0-only",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/starchat-irc/starchat.git"
    },
    "scripts": {
        "validate:servers": "node scripts/validate-servers.mjs",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config vite.demo.config.js",
        "build:demo": "vite build --config vite.demo.config.js"
    },
    "devDependencies": {
        "ajv": "^8.20.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "main": "./dist/starchat.js",
    "module": "./dist/starchat.js",
    "exports": {
        ".": "./dist/starchat.js",
        "./theme.css": "./src/ui/theme.css"
    },
    "files": [
        "dist",
        "src",
        "servers"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "dependencies": {
        "alpinejs": "^3.17.5",
        "bootstrap": "^5.3.9",
        "bootstrap-icons": "^1.13.2",
        "dompurify": "^3.4.18",
        "linkify-html": "^4.4.0",
        "linkifyjs": "^4.4.0"
    }
}
